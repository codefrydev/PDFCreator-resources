<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:PdfEditorApp.Plugins.Telemetry"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
             x:Class="PdfEditorApp.Plugins.Telemetry.DocumentTelemetryView"
             x:DataType="local:DocumentTelemetryViewModel"
             Width="300" Height="190">

    <Grid RowDefinitions="*,Auto" Margin="12,10,12,12">
        <!-- Telemetry Stats Grid -->
        <Border Grid.Row="0"
                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                Padding="12,8">
            <StackPanel Spacing="6">
                <!-- Managed Memory -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Managed Heap" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding MemoryAllocatedMb}" FontWeight="Bold" FontSize="12" Foreground="#34D399" VerticalAlignment="Center" />
                </Grid>

                <!-- Garbage Collections -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="GC Collections" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding GarbageCollections}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Engine Status -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Engine Status" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                </Grid>

                <!-- Architecture -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Architecture" FontSize="11.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Architecture}" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
            <Button Grid.Column="1"
                    Command="{Binding RefreshMetricsCommand}"
                    Classes="m3-tonal-btn"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Padding="10,4"
                    Margin="0,0,6,0"
                    Cursor="Hand"
                    ToolTip.Tip="Refresh Metrics">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" />
                    <TextBlock Text="Refresh" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Command="{Binding RunGCTrimCommand}"
                    Classes="m3-outlined-btn"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Padding="10,4"
                    Cursor="Hand"
                    ToolTip.Tip="Compact Garbage Collection and Free Memory">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="Broom" Width="13" Height="13" />
                    <TextBlock Text="Trim Heap" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>

</UserControl>
