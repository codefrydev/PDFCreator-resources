<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:PdfEditorApp.Plugins.Snake"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="420"
             x:Class="PdfEditorApp.Plugins.Snake.SnakeGameView"
             x:DataType="local:SnakeGameViewModel"
             Focusable="True">

    <Border Background="#161B22"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="16"
            BoxShadow="0 14 38 #60000000"
            ClipToBounds="True"
            Width="320"
            MinHeight="44">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 1. Header & Draggable Titlebar Handle -->
            <Border Grid.Row="0"
                    Background="#0D1117"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,0,1"
                    Padding="12,8"
                    Height="44"
                    PointerPressed="OnHeaderPointerPressed"
                    PointerMoved="OnHeaderPointerMoved"
                    PointerReleased="OnHeaderPointerReleased"
                    Cursor="SizeAll">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                    <!-- Title with Snake Emoji -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🐍" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="Snake"
                                   FontWeight="Bold"
                                   FontSize="13.5"
                                   Foreground="#F0F6FC"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Score Counter -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="Score" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Score}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#34D399"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="Best" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HighScore}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#D1D5DB"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Minimize Button -->
                    <Button Grid.Column="2"
                            Classes="m3-icon-btn"
                            Width="26" Height="26"
                            Padding="0"
                            Margin="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnMinimizeClick"
                            ToolTip.Tip="Minimize / Expand Overlay">
                        <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="#8B949E" />
                    </Button>

                    <!-- Close Button -->
                    <Button Grid.Column="3"
                            Classes="m3-icon-btn"
                            Width="26" Height="26"
                            Padding="0"
                            Margin="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnCloseClick"
                            ToolTip.Tip="Close Snake Game">
                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="#8B949E" />
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Game Canvas Area (Collapses when Minimized) -->
            <Grid Grid.Row="1"
                  x:Name="CanvasContainer"
                  Margin="12,10,12,8"
                  Width="296" Height="296"
                  ClipToBounds="True">

                <Border CornerRadius="10" ClipToBounds="True" BorderBrush="#21262D" BorderThickness="1">
                    <local:SnakeCanvasControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>

                <!-- Game Over State Overlay -->
                <Border Background="#D90D1117"
                        CornerRadius="10"
                        IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static local:SnakeGameState.GameOver}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="GAME OVER"
                                   FontSize="20"
                                   FontWeight="ExtraBold"
                                   Foreground="#EF4444"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   Foreground="#D1D5DB"
                                   HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Score:" FontSize="13" Foreground="#9CA3AF" />
                            <TextBlock Text="{Binding Score}" FontSize="14" FontWeight="Bold" Foreground="#34D399" />
                        </StackPanel>
                        <Button Command="{Binding TogglePlayPauseCommand}"
                                Classes="m3-filled-btn"
                                Background="#22C55E"
                                Foreground="#064E3B"
                                FontWeight="Bold"
                                FontSize="12.5"
                                CornerRadius="9999"
                                Padding="16,6"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Restart" Width="14" Height="14" />
                                <TextBlock Text="Play Again" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Paused State Overlay -->
                <Border Background="#A00D1117"
                        CornerRadius="10"
                        IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static local:SnakeGameState.Paused}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="PAUSED"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F9FAFB"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Press Space to Resume"
                                   FontSize="11.5"
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Bottom Controls & Help Legend -->
            <Border Grid.Row="2"
                    x:Name="FooterContainer"
                    Padding="12,0,12,12">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <!-- Play / Pause Pill Action Button -->
                    <Button Grid.Column="0"
                            Command="{Binding TogglePlayPauseCommand}"
                            Classes="m3-filled-btn"
                            Background="#22C55E"
                            Foreground="#052E16"
                            FontWeight="Bold"
                            FontSize="12"
                            CornerRadius="9999"
                            Padding="16,6"
                            Cursor="Hand">
                        <TextBlock Text="{Binding ActionButtonLabel}" VerticalAlignment="Center" />
                    </Button>

                    <!-- Control Keys Hint -->
                    <TextBlock Grid.Column="1"
                               Text="Arrows / WASD · Space"
                               FontSize="11"
                               Foreground="#8B949E"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>
