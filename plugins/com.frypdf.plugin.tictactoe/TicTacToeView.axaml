<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FryPdf.Plugin.TicTacToe"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="FryPdf.Plugin.TicTacToe.TicTacToeView"
             x:DataType="local:TicTacToeViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14" Width="300">

        <!-- 1. Game Mode & Mode Toggle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <!-- Status Badge Pill -->
            <Border Grid.Column="0"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Background="{DynamicResource M3SurfaceContainerHighBrush}"
                    Padding="10,5"
                    HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Mode Toggle Chip -->
            <Button Grid.Column="1"
                    Classes="m3-tonal-btn"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Command="{Binding ToggleAiModeCommand}"
                    Padding="8,4"
                    ToolTip.Tip="Switch between Single-Player vs AI and Local 2-Player pass-and-play">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="RobotOutline" Width="14" Height="14"
                                                IsVisible="{Binding IsAiMode}" />
                    <materialIcons:MaterialIcon Kind="AccountMultipleOutline" Width="14" Height="14"
                                                IsVisible="{Binding !IsAiMode}" />
                    <TextBlock Text="{Binding IsAiMode, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue='vs AI'}"
                               FontSize="11" FontWeight="Medium">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="IsAiMode" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. Scoreboard Cards (M3 Medium Corners) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,14">
            <!-- X Score -->
            <Border Grid.Column="0"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    CornerRadius="{StaticResource M3ShapeCornerMedium}"
                    Padding="6,8" Margin="0,0,4,0">
                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="❌ X Wins" FontSize="10.5" Foreground="{DynamicResource M3PrimaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding XWins}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                </StackPanel>
            </Border>

            <!-- Draws -->
            <Border Grid.Column="1"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    CornerRadius="{StaticResource M3ShapeCornerMedium}"
                    Padding="6,8" Margin="2,0,2,0">
                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="🤝 Draws" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Draws}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                </StackPanel>
            </Border>

            <!-- O Score -->
            <Border Grid.Column="2"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    CornerRadius="{StaticResource M3ShapeCornerMedium}"
                    Padding="6,8" Margin="4,0,0,0">
                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="⭕ O Wins" FontSize="10.5" Foreground="{DynamicResource M3SecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding OWins}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. The 3x3 Game Board Grid -->
        <Border Grid.Row="2"
                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                CornerRadius="{StaticResource M3ShapeCornerLarge}"
                Padding="8" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="3" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:TicTacToeCellViewModel">
                        <Button Width="82" Height="82" Margin="3"
                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                Command="{Binding $parent[UserControl].((local:TicTacToeViewModel)DataContext).MakeMoveCommand}"
                                CommandParameter="{Binding Index}"
                                IsEnabled="{Binding IsEnabled}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
                                </Style>
                                <!-- Highlight Winning Line -->
                                <Style Selector="Button[IsEnabled=False]">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="{Binding Value}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 4. Action Buttons (Tactile Pills) -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
            <!-- New Round / Restart Button -->
            <Button Grid.Column="0"
                    Classes="m3-filled-btn"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Command="{Binding ResetGameCommand}"
                    Margin="0,0,8,0"
                    Padding="14,9"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="Restart" Width="16" Height="16" />
                    <TextBlock Text="New Game" FontWeight="SemiBold" FontSize="12.5" />
                </StackPanel>
            </Button>

            <!-- Reset Scores Button -->
            <Button Grid.Column="1"
                    Classes="m3-tonal-btn"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Command="{Binding ResetScoresCommand}"
                    Padding="10,9"
                    ToolTip.Tip="Reset Win/Draw Counters">
                <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16" />
            </Button>
        </Grid>

    </Grid>
</UserControl>
