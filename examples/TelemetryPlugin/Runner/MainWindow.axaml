<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:PdfEditorApp.Plugins.Telemetry"
        mc:Ignorable="d"
        x:Class="PdfEditorApp.Plugins.Telemetry.Runner.MainWindow"
        Title="Document Telemetry HUD - Standalone Runner"
        Width="380" Height="280"
        MinWidth="320" MinHeight="220"
        WindowStartupLocation="CenterScreen"
        Background="#090D13">

    <Grid Margin="18">
        <local:DocumentTelemetryView x:Name="TelemetryView"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
    </Grid>
</Window>
