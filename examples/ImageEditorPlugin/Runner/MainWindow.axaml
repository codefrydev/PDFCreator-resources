<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
        mc:Ignorable="d"
        x:Class="PdfEditorApp.Plugins.ImageEditor.Runner.MainWindow"
        Title="🎨 Image Studio — Standalone Runner"
        Width="1200" Height="800"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource M3SurfaceContainerLowestBrush}">

    <local:ImageEditorView x:Name="EditorView"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
</Window>
