<UserControl xmlns="https://github.com/avaloniaui"
             x:Name="EditorRoot"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PdfEditorApp.Plugins.ImageEditor"
             xmlns:models="using:PdfEditorApp.Plugins.ImageEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.ImageEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:colorPicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             xmlns:models_templates="using:PdfEditorApp.Plugins.ImageEditor.Models.Templates"
             xmlns:models_textstyles="using:PdfEditorApp.Plugins.ImageEditor.Models.TextStyles"
             xmlns:models_shapes="using:PdfEditorApp.Plugins.ImageEditor.Models.Shapes"
             xmlns:models_stickers="using:PdfEditorApp.Plugins.ImageEditor.Models.Stickers"
             x:Class="PdfEditorApp.Plugins.ImageEditor.ImageEditorView"
             x:DataType="local:ImageEditorViewModel"
             Background="{DynamicResource M3SurfaceContainerLowestBrush}">

    <UserControl.Resources>
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
        <local:ElementTypeToIconConverter x:Key="ElementTypeToIconConverter" />
        <local:IsVisibleToIconConverter x:Key="IsVisibleToIconConverter" />
        <local:ZoomLevelToPercentConverter x:Key="ZoomLevelToPercentConverter" />
        <local:BooleanToStringConverter x:Key="BooleanToStringConverter" />
        <local:EqualityToBooleanConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <!-- Master Layout: Grid with Rows:
         Row 0: Top Studio Bar (Height Auto ~42px)
         Row 1: Studio Ribbon Toolbar (Height Auto ~130px)
         Row 2: Main Workspace (Sidebar + Canvas + Rulers + Inspector) (Height *)
         Row 3: Studio Status Bar (Height 28px) -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ============================================================
             ROW 0: TOP STUDIO COMMAND BAR (FryPDF Studio Header)
             ============================================================ -->
        <Border x:Name="TopStudioBar"
                Grid.Row="0"
                Background="{DynamicResource WinBgBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,0,0,1"
                Height="42"
                Padding="12,0,12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Studio Logo & Editable Document Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="m3-icon-btn" Width="28" Height="28" Command="{Binding CloseOverlayCommand}" ToolTip.Tip="Close Studio (Esc)">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" Foreground="{DynamicResource WinTextBrush}" />
                    </Button>
                    <Border Background="{DynamicResource M3PrimaryBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Width="24" Height="24">
                        <materialIcons:MaterialIcon Kind="Palette" Width="13" Height="13" Foreground="{DynamicResource M3OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Image Studio" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource M3PrimaryContainerBrush}" CornerRadius="4" Padding="5,1">
                        <TextBlock Text="STUDIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryContainerBrush}" />
                    </Border>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />
                    <!-- Editable Document Name -->
                    <TextBox Classes="m3-plain" Text="{Binding DocumentTitle, Mode=TwoWay}"
                             FontWeight="SemiBold" FontSize="12.5" MinWidth="140" MaxWidth="260"
                             Padding="4,2" VerticalAlignment="Center"
                             ToolTip.Tip="Click to rename design" />
                    <materialIcons:MaterialIcon Kind="PencilOutline" Width="12" Height="12" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Global Search / Command Bar Cue -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Classes="m3-card-outlined" Background="{DynamicResource WinInputBgBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Height="28" Padding="12,0" MinWidth="240">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="13" Height="13" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Type ⌘K to insert tools, shapes, filters..." FontSize="11" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                            <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerHighBrush}" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="⌘K" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Right: Quick Action Controls & Project Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Undo / Redo Cluster -->
                    <Border Classes="m3-segmented-container">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Classes="m3-segment-btn" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (⌘Z / Ctrl+Z)">
                                <materialIcons:MaterialIcon Kind="Undo" Width="14" Height="14" />
                            </Button>
                            <Button Classes="m3-segment-btn" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (⌘Y / Ctrl+Y)">
                                <materialIcons:MaterialIcon Kind="Redo" Width="14" Height="14" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Toggle Rulers & Grid -->
                    <Border Classes="m3-segmented-container">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding ShowRulers, Mode=TwoWay}" ToolTip.Tip="Toggle Dual Rulers">
                                <materialIcons:MaterialIcon Kind="Ruler" Width="13" Height="13" />
                            </ToggleButton>
                            <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding ShowGrid, Mode=TwoWay}" ToolTip.Tip="Toggle Alignment Grid">
                                <materialIcons:MaterialIcon Kind="Grid" Width="13" Height="13" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- Clear Canvas -->
                    <Button Classes="m3-icon-btn" Width="28" Height="28" Command="{Binding RequestClearCanvasCommand}" ToolTip.Tip="Clear Canvas">
                        <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="15" Height="15" Foreground="{DynamicResource WinDangerBrush}" />
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource WinBorderBrush}" Margin="2,0" />

                    <!-- Save / Open JSON -->
                    <Button Classes="m3-tonal-btn" Height="28" Padding="8,0" Command="{Binding OpenProjectJsonCommand}" ToolTip.Tip="Open Project JSON">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" />
                            <TextBlock Text="Open" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="m3-tonal-btn" Height="28" Padding="8,0" Command="{Binding SaveProjectJsonCommand}" ToolTip.Tip="Save Project JSON">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" />
                            <TextBlock Text="Save" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Export PNG -->
                    <Button Classes="primary-btn" Height="28" Padding="12,0" Command="{Binding ExportPngCommand}" ToolTip.Tip="Export Flattened PNG">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <materialIcons:MaterialIcon Kind="Download" Width="13" Height="13" Foreground="White" />
                            <TextBlock Text="Export PNG" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             ROW 1: FULL-WIDTH STUDIO RIBBON TOOLBAR (Matches RibbonView)
             ============================================================ -->
        <Border x:Name="ContextualRibbon"
                Grid.Row="1"
                Background="{DynamicResource WinPanelBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid RowDefinitions="Auto,Auto">

                <!-- 1. Ribbon Menu Tabs Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource WinBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,3,12,3">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer Classes="ribbon-scroll-viewer" Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <!-- File Tab (Accent Pill) -->
                                <Button Classes="ribbon-file-tab"
                                        Command="{Binding OpenTemplateGalleryCommand}"
                                        ToolTip.Tip="Explore Starter Design Templates">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FileOutline" Width="13" Height="13" Foreground="White" />
                                        <TextBlock Text="File" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5" />
                                    </StackPanel>
                                </Button>

                                <!-- Home & Design Tab -->
                                <Button Classes="ribbon-tab"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Home}"
                                        Command="{Binding SelectRibbonTabCommand}" CommandParameter="Home"
                                        ToolTip.Tip="Home &amp; Design Setup Tab">
                                    <TextBlock Text="Home" />
                                </Button>

                                <!-- Shapes & Draw Tab -->
                                <Button Classes="ribbon-tab"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Shapes}"
                                        Command="{Binding SelectRibbonTabCommand}" CommandParameter="Shapes"
                                        ToolTip.Tip="Shapes, Vector Paths &amp; Drawing Tab">
                                    <TextBlock Text="Shapes &amp; Draw" />
                                </Button>

                                <!-- Typography Tab -->
                                <Button Classes="ribbon-tab"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Typography}"
                                        Command="{Binding SelectRibbonTabCommand}" CommandParameter="Typography"
                                        ToolTip.Tip="Typography, Fonts &amp; Text Styles Tab">
                                    <TextBlock Text="Typography" />
                                </Button>

                                <!-- Photo & Filters Tab -->
                                <Button Classes="ribbon-tab"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Photo}"
                                        Command="{Binding SelectRibbonTabCommand}" CommandParameter="Photo"
                                        ToolTip.Tip="Photo Adjustments, Crop &amp; Filters Tab">
                                    <TextBlock Text="Photo &amp; Filters" />
                                </Button>

                                <!-- Arrange & Align Tab -->
                                <Button Classes="ribbon-tab"
                                        Classes.active="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Arrange}"
                                        Command="{Binding SelectRibbonTabCommand}" CommandParameter="Arrange"
                                        ToolTip.Tip="Align, Distribute, Group &amp; Layer Order Tab">
                                    <TextBlock Text="Arrange &amp; Align" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Actions: Collapse Ribbon -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Classes="mini-tool-btn" Width="26" Height="26"
                                    Command="{Binding ToggleRibbonCollapseCommand}"
                                    ToolTip.Tip="Minimize / Expand Ribbon">
                                <Panel>
                                    <materialIcons:MaterialIcon Kind="ChevronUp" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" IsVisible="{Binding !IsRibbonCollapsed}" />
                                    <materialIcons:MaterialIcon Kind="ChevronDown" Width="15" Height="15" Foreground="{DynamicResource WinMutedBrush}" IsVisible="{Binding IsRibbonCollapsed}" />
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Dynamic Tools Panel (Height ~100) -->
                <Border Grid.Row="1"
                        Background="{DynamicResource WinPanelBrush}"
                        Height="102" Padding="12,4,12,4"
                        IsVisible="{Binding !IsRibbonCollapsed}">
                    <ScrollViewer Classes="ribbon-scroll-viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Panel>
                            <!-- ================= TAB: HOME & DESIGN ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Home}">

                                <!-- Group 1: History -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (⌘Z / Ctrl+Z)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Undo" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Undo" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (⌘Y / Ctrl+Y)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Redo" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Redo" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding RequestClearCanvasCommand}" ToolTip.Tip="Clear All Elements">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="{DynamicResource WinDangerBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Clear" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinDangerBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="History" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 2: Clipboard -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding PasteElementsCommand}" ToolTip.Tip="Paste Elements (⌘V / Ctrl+V)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="ContentPaste" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Paste" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <Button Classes="mini-tool-btn" Command="{Binding CutElementsCommand}" ToolTip.Tip="Cut Selected (⌘X / Ctrl+X)">
                                                <materialIcons:MaterialIcon Kind="ContentCut" Width="13" Height="13" Foreground="{DynamicResource WinTextBrush}" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding CopyElementsCommand}" ToolTip.Tip="Copy Selected (⌘C / Ctrl+C)">
                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="13" Height="13" Foreground="{DynamicResource WinTextBrush}" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate (⌘D / Ctrl+D)">
                                                <materialIcons:MaterialIcon Kind="ContentDuplicate" Width="13" Height="13" Foreground="{DynamicResource WinTextBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Clipboard" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 3: Quick Insert Elements -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding SetToolCommand}" CommandParameter="text" ToolTip.Tip="Add Text (T)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="FormatSize" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Text" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding ImportImageCommand}" ToolTip.Tip="Import Photo">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="ImagePlus" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Image" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding SelectSidebarTabCommand}" CommandParameter="Shapes" ToolTip.Tip="Open Shapes Gallery">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="ShapeOutline" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Shapes" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Quick Insert" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 4: Pointers & Drawing -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding SetToolCommand}" CommandParameter="select" ToolTip.Tip="Select / Move Tool (V)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="CursorDefaultOutline" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Select" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding SetToolCommand}" CommandParameter="sample" ToolTip.Tip="Color Eyedropper">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Eyedropper" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Sample" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Tools" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 5: Artboard Setup (Preset Chips & Orientation) -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button Classes="m3-preset-chip" Command="{Binding ResizeCanvasCommand}" CommandParameter="1080x1080" ToolTip.Tip="Square (1080×1080)">
                                                <TextBlock Text="1:1" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ResizeCanvasCommand}" CommandParameter="1280x720" ToolTip.Tip="YouTube HD (1280×720)">
                                                <TextBlock Text="16:9" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ResizeCanvasCommand}" CommandParameter="1080x1920" ToolTip.Tip="Story (1080×1920)">
                                                <TextBlock Text="Story" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ResizeCanvasCommand}" CommandParameter="1240x1754" ToolTip.Tip="A4 Print (1240×1754)">
                                                <TextBlock Text="A4" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding SwapOrientationCommand}" ToolTip.Tip="Swap Orientation">
                                                <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="12" Height="12" />
                                            </Button>
                                        </StackPanel>
                                        <!-- Canvas Background Color Capsule -->
                                        <Border Classes="m3-segmented-container" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <Button Command="{Binding SetBackgroundCommand}" CommandParameter="White"
                                                        Classes="m3-segment-btn"
                                                        Classes.active="{Binding BackgroundColorName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=White}"
                                                        ToolTip.Tip="White Canvas Background">
                                                    <TextBlock Text="White" FontSize="10" />
                                                </Button>
                                                <Button Command="{Binding SetBackgroundCommand}" CommandParameter="Black"
                                                        Classes="m3-segment-btn"
                                                        Classes.active="{Binding BackgroundColorName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Black}"
                                                        ToolTip.Tip="Dark Canvas Background">
                                                    <TextBlock Text="Dark" FontSize="10" />
                                                </Button>
                                                <Button Command="{Binding SetBackgroundCommand}" CommandParameter="Transparent"
                                                        Classes="m3-segment-btn"
                                                        Classes.active="{Binding BackgroundColorName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Transparent}"
                                                        ToolTip.Tip="Transparent Checkerboard">
                                                    <materialIcons:MaterialIcon Kind="Checkerboard" Width="12" Height="12" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Artboard Setup" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- ================= TAB: SHAPES & DRAW ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Shapes}">

                                <!-- Group 1: Pointers & Tools -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding SetToolCommand}" CommandParameter="select" ToolTip.Tip="Select (V)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="CursorDefaultOutline" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Select" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding SetToolCommand}" CommandParameter="sample" ToolTip.Tip="Eyedropper">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Eyedropper" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Sample" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Pointers" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 2: Basic Shapes (2 Rows of Vector Geometries) -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button Classes="mini-tool-btn" Command="{Binding SetToolCommand}" CommandParameter="rect" ToolTip.Tip="Rectangle">
                                                <materialIcons:MaterialIcon Kind="SquareOutline" Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding SetToolCommand}" CommandParameter="ellipse" ToolTip.Tip="Circle / Ellipse">
                                                <materialIcons:MaterialIcon Kind="CircleOutline" Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding SetToolCommand}" CommandParameter="arrow" ToolTip.Tip="Directional Arrow">
                                                <materialIcons:MaterialIcon Kind="ArrowRight" Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding SetToolCommand}" CommandParameter="line" ToolTip.Tip="Straight Line">
                                                <materialIcons:MaterialIcon Kind="VectorLine" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button Classes="mini-tool-btn" Command="{Binding SetToolCommand}" CommandParameter="star" ToolTip.Tip="5-Point Star">
                                                <materialIcons:MaterialIcon Kind="StarOutline" Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding SetToolCommand}" CommandParameter="polygon" ToolTip.Tip="Hexagon / Polygon">
                                                <materialIcons:MaterialIcon Kind="HexagonOutline" Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding SetToolCommand}" CommandParameter="triangle" ToolTip.Tip="Triangle">
                                                <materialIcons:MaterialIcon Kind="TriangleOutline" Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding SetToolCommand}" CommandParameter="heart" ToolTip.Tip="Heart Shape">
                                                <materialIcons:MaterialIcon Kind="HeartOutline" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Basic Shapes" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 3: Border & Stroke Controls -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Stroke" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                            <!-- Stroke Color Swatch + Flyout -->
                                            <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                    Background="{Binding StrokeColorField, Converter={StaticResource ColorToBrushConverter}}"
                                                    BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <ColorView Color="{Binding StrokeColorField, Mode=TwoWay}" IsAlphaEnabled="True" Width="260" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <NumericUpDown Value="{Binding StrokeThicknessField}" Minimum="0" Maximum="40" Increment="1"
                                                           FormatString="0 pt" Height="24" FontSize="10.5" Width="72" />
                                        </StackPanel>
                                        <!-- Dash Style Capsule -->
                                        <Border Classes="m3-segmented-container" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <Button Command="{Binding SetDashStyleCommand}" CommandParameter="Solid" Classes="m3-segment-btn">
                                                    <TextBlock Text="Solid" FontSize="9.5" />
                                                </Button>
                                                <Button Command="{Binding SetDashStyleCommand}" CommandParameter="Dashed" Classes="m3-segment-btn">
                                                    <TextBlock Text="Dashed" FontSize="9.5" />
                                                </Button>
                                                <Button Command="{Binding SetDashStyleCommand}" CommandParameter="Dotted" Classes="m3-segment-btn">
                                                    <TextBlock Text="Dotted" FontSize="9.5" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Stroke &amp; Border" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 4: Fill & Opacity Controls -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Fill" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                            <!-- Fill Color Swatch + Flyout -->
                                            <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                    Background="{Binding FillColorField, Converter={StaticResource ColorToBrushConverter}}"
                                                    BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <ColorView Color="{Binding FillColorField, Mode=TwoWay}" IsAlphaEnabled="True" Width="260" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ToggleGradientFillCommand}" Height="22" Padding="6,1">
                                                <TextBlock Text="Gradient" FontSize="9.5" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Opacity" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" Width="38" />
                                            <Slider Classes="m3-tactile-slider" Width="70" Minimum="0" Maximum="100" Value="{Binding OpacityField}" Height="18" />
                                            <TextBlock Text="{Binding OpacityField, StringFormat='{}{0:0}%'}" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" Width="28" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Fill &amp; Opacity" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 5: Shape Library Sidebar Launcher -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding SelectSidebarTabCommand}" CommandParameter="Shapes" ToolTip.Tip="Open Shapes &amp; Stickers Library">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="ShapePlus" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Library" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Full Library" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- ================= TAB: TYPOGRAPHY ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Typography}">

                                <!-- Group 1: Insert Text -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding SetToolCommand}" CommandParameter="text" ToolTip.Tip="Add Text (T)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="FormatSize" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Add Text" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding SelectSidebarTabCommand}" CommandParameter="Text" ToolTip.Tip="Explore Typographic Presets">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="FormatLetterCase" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Styles" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Insert Text" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 2: Typeface & Size Selection -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="4">
                                        <!-- Font Family Dropdown Button -->
                                        <Button Classes="m3-tonal-btn" Height="26" Padding="8,1" MinWidth="130" HorizontalContentAlignment="Stretch">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                            Padding="6" Width="220" MaxHeight="300">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl ItemsSource="{Binding FontGroups}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="local:FontGroupViewModel">
                                                                        <StackPanel Spacing="2" Margin="0,0,0,6">
                                                                            <TextBlock Text="{Binding GroupName}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="4,2" />
                                                                            <ItemsControl ItemsSource="{Binding Fonts}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="local:FontChoiceViewModel">
                                                                                        <Button Classes="m3-list-item-btn" HorizontalAlignment="Stretch" Padding="6,3"
                                                                                                Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SetTextFontFamilyCommand}"
                                                                                                CommandParameter="{Binding}">
                                                                                            <TextBlock Text="{Binding FamilyName}" FontFamily="{Binding PreviewFamily}" FontSize="12" />
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding FontFamilyNameField, FallbackValue='Inter'}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="MenuDown" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- Size Stepper -->
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <NumericUpDown Value="{Binding FontSizeField, Mode=TwoWay}"
                                                           Minimum="6" Maximum="288" Increment="2"
                                                           FormatString="0 pt" Height="26" FontSize="11" Width="80" />
                                            <Button Classes="m3-preset-chip" Command="{Binding SetToolCommand}" CommandParameter="text" Height="24" Padding="6,1">
                                                <TextBlock Text="18" FontSize="10" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding SetToolCommand}" CommandParameter="text" Height="24" Padding="6,1">
                                                <TextBlock Text="32" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Typeface &amp; Size" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 3: Formatting & Alignment (B, I, U, S, Align, Case) -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="3">
                                        <!-- Row 1: B, I, U, S -->
                                        <Border Classes="m3-segmented-container" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding IsBoldField, Mode=TwoWay}" ToolTip.Tip="Bold (⌘B)">
                                                    <TextBlock Text="B" FontWeight="Bold" FontSize="11" />
                                                </ToggleButton>
                                                <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding IsItalicField, Mode=TwoWay}" ToolTip.Tip="Italic (⌘I)">
                                                    <TextBlock Text="I" FontStyle="Italic" FontSize="11" />
                                                </ToggleButton>
                                                <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding IsUnderlineField, Mode=TwoWay}" ToolTip.Tip="Underline (⌘U)">
                                                    <TextBlock Text="U" TextDecorations="Underline" FontSize="11" />
                                                </ToggleButton>
                                                <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding IsStrikethroughField, Mode=TwoWay}" ToolTip.Tip="Strikethrough">
                                                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="11" />
                                                </ToggleButton>
                                            </StackPanel>
                                        </Border>

                                        <!-- Row 2: Alignments & Case -->
                                        <Border Classes="m3-segmented-container" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <Button Classes="m3-segment-btn" Command="{Binding SetAlignmentCommand}" CommandParameter="Left" ToolTip.Tip="Align Left">
                                                    <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="12" Height="12" />
                                                </Button>
                                                <Button Classes="m3-segment-btn" Command="{Binding SetAlignmentCommand}" CommandParameter="Center" ToolTip.Tip="Align Center">
                                                    <materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="12" Height="12" />
                                                </Button>
                                                <Button Classes="m3-segment-btn" Command="{Binding SetAlignmentCommand}" CommandParameter="Right" ToolTip.Tip="Align Right">
                                                    <materialIcons:MaterialIcon Kind="FormatAlignRight" Width="12" Height="12" />
                                                </Button>
                                                <Button Classes="m3-segment-btn" Command="{Binding ToggleTextCaseCommand}" ToolTip.Tip="Toggle Uppercase">
                                                    <TextBlock Text="Aa" FontSize="10" FontWeight="SemiBold" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Format &amp; Align" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 4: Text Colors -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Text" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" Width="30" />
                                            <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                    Background="{Binding TextForegroundColorField, Converter={StaticResource ColorToBrushConverter}}"
                                                    BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <ColorView Color="{Binding TextForegroundColorField, Mode=TwoWay}" IsAlphaEnabled="True" Width="260" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Bg" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" Width="30" />
                                            <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                    Background="{Binding HighlightColorField, Converter={StaticResource ColorToBrushConverter}}"
                                                    BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <ColorView Color="{Binding HighlightColorField, Mode=TwoWay}" IsAlphaEnabled="True" Width="260" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Colors" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- ================= TAB: PHOTO & FILTERS ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Photo}">

                                <!-- Group 1: Crop & Reset -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding StartCropCommand}" ToolTip.Tip="Crop Photo">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Crop" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Crop" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding ResetImageAdjustmentsCommand}" ToolTip.Tip="Reset All Adjustments">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Restore" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Reset" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <Button Classes="mini-tool-btn" Command="{Binding FlipHorizontalCommand}" ToolTip.Tip="Flip Horizontal">
                                                <materialIcons:MaterialIcon Kind="FlipHorizontal" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding FlipVerticalCommand}" ToolTip.Tip="Flip Vertical">
                                                <materialIcons:MaterialIcon Kind="FlipVertical" Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Crop &amp; Transform" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 2: Auto-Enhance & 1-Click Filters -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="3">
                                        <!-- Auto-Enhance Pill Button -->
                                        <Button Classes="primary-btn" Height="24" Padding="10,0" Command="{Binding AutoEnhanceCommand}" ToolTip.Tip="1-Click Intelligent Auto-Enhance">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="AutoFix" Width="12" Height="12" Foreground="White" />
                                                <TextBlock Text="Auto-Enhance" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Filter Chips Wrap Panel -->
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button Classes="m3-preset-chip" Command="{Binding ApplyFilterPresetCommand}" CommandParameter="Normal" ToolTip.Tip="Normal">
                                                <TextBlock Text="Normal" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ApplyFilterPresetCommand}" CommandParameter="Vivid" ToolTip.Tip="Vivid">
                                                <TextBlock Text="Vivid" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ApplyFilterPresetCommand}" CommandParameter="B&amp;W" ToolTip.Tip="Black &amp; White">
                                                <TextBlock Text="B&amp;W" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ApplyFilterPresetCommand}" CommandParameter="Sepia" ToolTip.Tip="Sepia">
                                                <TextBlock Text="Sepia" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ApplyFilterPresetCommand}" CommandParameter="Cool" ToolTip.Tip="Cool Tint">
                                                <TextBlock Text="Cool" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Command="{Binding ApplyFilterPresetCommand}" CommandParameter="Warm" ToolTip.Tip="Warm Tint">
                                                <TextBlock Text="Warm" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Photo Filters" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 3: Fine-Tuning Sliders (Brightness, Contrast, Saturation) -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="2">
                                        <Grid ColumnDefinitions="42,76,26" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="Bright" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                            <Slider Classes="m3-tactile-slider" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding BrightnessField}" Height="16" />
                                            <TextBlock Grid.Column="2" Text="{Binding BrightnessField, StringFormat='{}{0:0}'}" FontSize="9" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="42,76,26" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="Contrast" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                            <Slider Classes="m3-tactile-slider" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding ContrastField}" Height="16" />
                                            <TextBlock Grid.Column="2" Text="{Binding ContrastField, StringFormat='{}{0:0}'}" FontSize="9" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="42,76,26" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="Saturate" FontSize="9.5" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                                            <Slider Classes="m3-tactile-slider" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding SaturationField}" Height="16" />
                                            <TextBlock Grid.Column="2" Text="{Binding SaturationField, StringFormat='{}{0:0}'}" FontSize="9" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Light &amp; Color" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- ================= TAB: ARRANGE & ALIGN ================= -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ActiveRibbonTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Arrange}">

                                <!-- Group 1: Alignment & Distribution (2 Rows of 4 Buttons) -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button Classes="mini-tool-btn" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align Left">
                                                <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding AlignCenterHorizontalCommand}" ToolTip.Tip="Center Horizontally">
                                                <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding AlignRightCommand}" ToolTip.Tip="Align Right">
                                                <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding DistributeHorizontalCommand}" ToolTip.Tip="Distribute Horizontally">
                                                <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button Classes="mini-tool-btn" Command="{Binding AlignTopCommand}" ToolTip.Tip="Align Top">
                                                <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding AlignCenterVerticalCommand}" ToolTip.Tip="Center Vertically">
                                                <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding AlignBottomCommand}" ToolTip.Tip="Align Bottom">
                                                <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding DistributeVerticalCommand}" ToolTip.Tip="Distribute Vertically">
                                                <materialIcons:MaterialIcon Kind="DistributeVerticalCenter" Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Align &amp; Distribute" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 2: Layer Z-Order -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding BringToFrontCommand}" ToolTip.Tip="Bring to Front (Ctrl+])">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="ArrangeBringToFront" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Front" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding SendToBackCommand}" ToolTip.Tip="Send to Back (Ctrl+[)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="ArrangeSendToBack" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Back" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <Button Classes="mini-tool-btn" Command="{Binding BringForwardCommand}" ToolTip.Tip="Forward">
                                                <materialIcons:MaterialIcon Kind="ArrowUpBold" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="mini-tool-btn" Command="{Binding SendBackwardCommand}" ToolTip.Tip="Backward">
                                                <materialIcons:MaterialIcon Kind="ArrowDownBold" Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Layer Order" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 3: Grouping -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool-btn" Command="{Binding GroupSelectionCommand}" ToolTip.Tip="Group Selection (Ctrl+G)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Group" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Group" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="tool-btn" Command="{Binding UngroupSelectionCommand}" ToolTip.Tip="Ungroup Selection (Ctrl+Shift+G)">
                                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Ungroup" Width="18" Height="18" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Ungroup" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Group" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>

                                <Rectangle Width="1" Height="68" Fill="{DynamicResource WinBorderBrush}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Group 4: Flip & Rotate -->
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="mini-tool-btn" Command="{Binding FlipHorizontalCommand}" ToolTip.Tip="Flip Horizontal">
                                            <materialIcons:MaterialIcon Kind="FlipHorizontal" Width="14" Height="14" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding FlipVerticalCommand}" ToolTip.Tip="Flip Vertical">
                                            <materialIcons:MaterialIcon Kind="FlipVertical" Width="14" Height="14" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Command="{Binding RotateClockwiseCommand}" ToolTip.Tip="Rotate 90° Clockwise">
                                            <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Flip &amp; Rotate" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             ROW 2: MAIN WORKSPACE (Sidebar + Rulers + Canvas + Inspector)
             ============================================================ -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ClipToBounds="True">

            <!-- ──────────────────────────────────────────────────────────
                 COLUMN 0: DOCKABLE LEFT STUDIO SIDEBAR (Width 280)
                 ────────────────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="0,0,1,0"
                    Width="300"
                    IsVisible="{Binding !IsSidebarCollapsed}">
                <Grid RowDefinitions="Auto,*">

                    <!-- Tab Header Strip (Templates, Shapes, Text, Layers) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource M3SurfaceBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0" Classes="m3-segmented-container" Padding="2">
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Classes="m3-segment-btn" Padding="2,0" Height="28"
                                            Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Templates}"
                                            Command="{Binding SelectSidebarTabCommand}" CommandParameter="Templates"
                                            ToolTip.Tip="Design Templates">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="13" Height="13" />
                                            <TextBlock Text="Templates" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="m3-segment-btn" Padding="2,0" Height="28"
                                            Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Shapes}"
                                            Command="{Binding SelectSidebarTabCommand}" CommandParameter="Shapes"
                                            ToolTip.Tip="Shapes &amp; Stickers">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ShapeOutline" Width="13" Height="13" />
                                            <TextBlock Text="Shapes" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="m3-segment-btn" Padding="2,0" Height="28"
                                            Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Text}"
                                            Command="{Binding SelectSidebarTabCommand}" CommandParameter="Text"
                                            ToolTip.Tip="Typography Blocks">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FormatText" Width="13" Height="13" />
                                            <TextBlock Text="Text" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Classes="m3-segment-btn" Padding="2,0" Height="28"
                                            Classes.active="{Binding ActiveSidebarTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Layers}"
                                            Command="{Binding SelectSidebarTabCommand}" CommandParameter="Layers"
                                            ToolTip.Tip="Visual Layer Stack">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="13" Height="13" />
                                            <TextBlock Text="Layers" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Button Grid.Column="1" Classes="m3-icon-btn" Width="28" Height="28" Margin="4,0,0,0"
                                    Command="{Binding ToggleSidebarCollapseCommand}"
                                    ToolTip.Tip="Collapse Sidebar">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Sidebar Tab Content Panels -->
                    <Panel Grid.Row="1">
                        <!-- TAB A: TEMPLATES -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Templates}">
                            <StackPanel Spacing="10" Margin="10">
                                <TextBlock Text="Starter Design Templates" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                <ItemsControl ItemsSource="{Binding FilteredTemplateCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:TemplateCardViewModel">
                                            <Border Classes="m3-card-elevated" Margin="0,4" Padding="0" ClipToBounds="True" CornerRadius="{StaticResource M3ShapeCornerMedium}">
                                                <Button Classes="m3-plain" HorizontalAlignment="Stretch"
                                                        Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).UseTemplateCommand}"
                                                        CommandParameter="{Binding Definition}">
                                                    <Grid RowDefinitions="104,Auto">
                                                        <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerHighestBrush}" ClipToBounds="True" Padding="8">
                                                            <Border Background="White"
                                                                    CornerRadius="3"
                                                                    BoxShadow="0 2 8 #22000000"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    ClipToBounds="True">
                                                                <Image Source="{Binding Preview}" Stretch="Uniform" MaxHeight="88" />
                                                            </Border>
                                                        </Border>
                                                        <Border Grid.Row="1" Background="{DynamicResource M3SurfaceContainerLowBrush}" Padding="10,7">
                                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                <Border Grid.Column="1" Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,2" Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding DimensionsLabel}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB B: SHAPES & STICKERS -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Shapes}">
                            <StackPanel Spacing="10" Margin="10">
                                <TextBlock Text="Shape Library" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                <ItemsControl ItemsSource="{Binding ShapeGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ShapeGroupViewModel">
                                            <StackPanel Spacing="6" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                <ItemsControl ItemsSource="{Binding Shapes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:ShapeCardViewModel">
                                                            <Button Classes="m3-card-elevated" Width="48" Height="48" Margin="3" Padding="4"
                                                                    Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).InsertShapeCommand}"
                                                                    CommandParameter="{Binding Definition}"
                                                                    ToolTip.Tip="{Binding Name}">
                                                                <local:ShapePreviewControl Element="{Binding PreviewElement}" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB C: TEXT STYLES -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Text}">
                            <StackPanel Spacing="8" Margin="10">
                                <TextBlock Text="Text Style Presets" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                <ItemsControl ItemsSource="{Binding TextStyleGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:TextStyleGroupViewModel">
                                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="2,2" />
                                                <ItemsControl ItemsSource="{Binding Styles}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models_textstyles:TextStyleDefinition">
                                                            <Button Classes="m3-tonal-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                    Margin="0,2" Height="34" Padding="10,4"
                                                                    Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ApplyTextStyleCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <Border Grid.Column="1" Classes="m3-chip" Background="{DynamicResource M3SurfaceContainerHighestBrush}" Padding="6,1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FontSize, StringFormat='{}{0} pt'}" FontSize="9.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- TAB D: VISUAL LAYER STACK -->
                        <Grid RowDefinitions="*,Auto"
                              IsVisible="{Binding ActiveSidebarTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Layers}">
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6" Margin="10">
                                    <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,4">
                                        <TextBlock Grid.Column="0" Text="Document Layers" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Elements.Count, StringFormat='{}{0} Items'}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding LayersDescendingZ}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CanvasElement">
                                                <Button Classes="m3-layer-row"
                                                        Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).SelectElementFromLayerPanelCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" Background="{DynamicResource M3SurfaceContainerHighBrush}" Margin="0,0,6,0">
                                                            <materialIcons:MaterialIcon Kind="{Binding ElementType, Converter={StaticResource ElementTypeToIconConverter}}" Width="12" Height="12" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Classes="mini-tool-btn" Width="22" Height="22" Margin="2,0"
                                                                Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ToggleLayerVisibilityCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Toggle Visibility">
                                                            <materialIcons:MaterialIcon Kind="{Binding IsVisible, Converter={StaticResource IsVisibleToIconConverter}}" Width="12" Height="12" />
                                                        </Button>
                                                        <Button Grid.Column="3" Classes="mini-tool-btn" Width="22" Height="22"
                                                                Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).ToggleLayerLockCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Lock / Unlock">
                                                            <Panel>
                                                                <materialIcons:MaterialIcon Kind="Lock" Width="12" Height="12" IsVisible="{Binding IsLocked}" />
                                                                <materialIcons:MaterialIcon Kind="LockOpenVariant" Width="12" Height="12" IsVisible="{Binding !IsLocked}" />
                                                            </Panel>
                                                        </Button>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom Layer Ordering Buttons -->
                            <Border Grid.Row="1" Background="{DynamicResource M3SurfaceBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="8">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <Button Grid.Column="0" Classes="m3-tonal-btn" Height="28" Command="{Binding BringForwardCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="14" Height="14" />
                                            <TextBlock Text="Move Up" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="m3-tonal-btn" Height="28" Command="{Binding SendBackwardCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
                                            <TextBlock Text="Move Down" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Panel>
                </Grid>
            </Border>

            <!-- Column 1: Left Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns"
                          IsVisible="{Binding !IsSidebarCollapsed}" />

            <!-- ──────────────────────────────────────────────────────────
                 COLUMN 2: WORKSPACE CANVAS & DUAL RULERS
                 ────────────────────────────────────────────────────────── -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*" ClipToBounds="True">

                <!-- Ruler Origin Corner Square (Matches DocumentCanvasView.axaml) -->
                <Border Grid.Row="0" Grid.Column="0" Width="20" Height="20"
                        Background="{DynamicResource WinInputBgBrush}"
                        BorderBrush="{DynamicResource WinBorderBrush}"
                        BorderThickness="0,0,1,1"
                        IsVisible="{Binding ShowRulers}">
                    <materialIcons:MaterialIcon Kind="RulerSquare" Width="11" Height="11"
                                                Foreground="{DynamicResource WinMutedBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Top Horizontal Ruler -->
                <views:CanvasRulerControl Grid.Row="0" Grid.Column="1" Height="20"
                                          Orientation="Horizontal"
                                          ZoomLevel="{Binding ZoomLevel}"
                                          CursorPosition="{Binding CursorCanvasX}"
                                          PageOffset="{Binding CanvasOriginScreenX}"
                                          PageDimension="{Binding CanvasWidth}"
                                          IsVisible="{Binding ShowRulers}" />

                <!-- Left Vertical Ruler -->
                <views:CanvasRulerControl Grid.Row="1" Grid.Column="0" Width="20"
                                          Orientation="Vertical"
                                          ZoomLevel="{Binding ZoomLevel}"
                                          CursorPosition="{Binding CursorCanvasY}"
                                          PageOffset="{Binding CanvasOriginScreenY}"
                                          PageDimension="{Binding CanvasHeight}"
                                          IsVisible="{Binding ShowRulers}" />

                <!-- Canvas Viewport with Deep Pasteboard Background (#0F172A) -->
                <Grid Grid.Row="1" Grid.Column="1" Background="#0F172A" ClipToBounds="True">
                    <!-- Clean Artboard Selection Badge in Top-Left Corner -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="14,14,0,0"
                            Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            Padding="8,3.5"
                            BoxShadow="0 2 8 #20000000"
                            IsHitTestVisible="False"
                            ZIndex="100">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Artboard" Width="13" Height="13"
                                                        Foreground="{DynamicResource M3PrimaryBrush}" />
                            <TextBlock Text="{Binding ArtboardSelectionLabel}"
                                       FontWeight="SemiBold"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource M3OnSurfaceBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Interactive Canvas Control -->
                    <local:EditorCanvasControl x:Name="CanvasControl"
                                               ClipToBounds="True"
                                               Focusable="True"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />

                    <!-- Inline double-click Text Editing Box -->
                    <TextBox x:Name="InlineTextEditBox"
                             IsVisible="False"
                             Classes="m3-outlined"
                             Background="{DynamicResource M3SurfaceBrush}"
                             BorderBrush="{DynamicResource M3PrimaryBrush}"
                             BorderThickness="2"
                             CornerRadius="4"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Padding="6,4"
                             ZIndex="200" />

                    <!-- Floating Selection Quick-Actions Cluster (M3 Pill with 16px Safe Clearance) -->
                    <Border x:Name="QuickActionsCluster"
                            IsVisible="{Binding HasSelectedElements}"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerFull}"
                            BoxShadow="{StaticResource M3ElevationLevel2}"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            ZIndex="150">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="mini-tool-btn" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate (Ctrl+D)">
                                <materialIcons:MaterialIcon Kind="ContentDuplicate" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            </Button>
                            <Button Classes="mini-tool-btn" Command="{Binding BringForwardCommand}" ToolTip.Tip="Bring Forward">
                                <materialIcons:MaterialIcon Kind="ArrowUpBold" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            </Button>
                            <Button Classes="mini-tool-btn" Command="{Binding SendBackwardCommand}" ToolTip.Tip="Send Backward">
                                <materialIcons:MaterialIcon Kind="ArrowDownBold" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            </Button>
                            <Button Classes="mini-tool-btn" Command="{Binding DeleteSelectedElementCommand}" ToolTip.Tip="Delete (Del)">
                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="13" Height="13" Foreground="{DynamicResource M3ErrorBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Column 3: Right Splitter -->
            <GridSplitter Grid.Column="3" Width="4" Background="Transparent" ResizeDirection="Columns"
                          IsVisible="{Binding !IsInspectorCollapsed}" />

            <!-- ──────────────────────────────────────────────────────────
                 COLUMN 4: RIGHT PROPERTIES INSPECTOR (Width 300)
                 Page & Canvas Setup (Matches InspectorSidebarView Card-For-Card)
                 ────────────────────────────────────────────────────────── -->
            <Border Grid.Column="4"
                    Background="{DynamicResource M3SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1,0,0,0"
                    Width="300"
                    IsVisible="{Binding !IsInspectorCollapsed}">
                <Grid RowDefinitions="Auto,*">

                    <!-- Inspector Header (Clean Title, No Rogue Badge) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource M3SurfaceBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Tune" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                <TextBlock Text="Properties &amp; Format" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="m3-icon-btn" Width="26" Height="26"
                                    Command="{Binding ToggleInspectorCollapseCommand}"
                                    ToolTip.Tip="Collapse Inspector">
                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Inspector Content Zone -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="10">

                            <!-- ══════════════════════════════════════════════════════
                                 CARD 1: PAGE & CANVAS SETUP (Direct Parity with Image 1)
                                 ══════════════════════════════════════════════════════ -->
                            <Border Classes="m3-card-elevated">
                                <StackPanel Spacing="10">
                                    <!-- Header -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Background="{DynamicResource M3PrimaryContainerBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="Page &amp; Canvas Setup" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                            <TextBlock Text="Standards, orientation &amp; dimensions" FontSize="9.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Paper Size Standard Chips -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Paper Size Standard" Classes="inspector-label" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="m3-preset-chip" Margin="0,0,5,5"
                                                    Classes.active="{Binding ActivePaperSize, Converter={StaticResource StringEqualsConverter}, ConverterParameter=1080x1080}"
                                                    Command="{Binding ResizeCanvasCommand}" CommandParameter="1080x1080" ToolTip.Tip="Square 1:1 (1080×1080)">
                                                <TextBlock Text="Square 1:1" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Margin="0,0,5,5"
                                                    Classes.active="{Binding ActivePaperSize, Converter={StaticResource StringEqualsConverter}, ConverterParameter=1280x720}"
                                                    Command="{Binding ResizeCanvasCommand}" CommandParameter="1280x720" ToolTip.Tip="16:9 HD (1280×720)">
                                                <TextBlock Text="16:9 HD" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Margin="0,0,5,5"
                                                    Classes.active="{Binding ActivePaperSize, Converter={StaticResource StringEqualsConverter}, ConverterParameter=1080x1920}"
                                                    Command="{Binding ResizeCanvasCommand}" CommandParameter="1080x1920" ToolTip.Tip="Story 9:16 (1080×1920)">
                                                <TextBlock Text="Story 9:16" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Margin="0,0,5,5"
                                                    Classes.active="{Binding ActivePaperSize, Converter={StaticResource StringEqualsConverter}, ConverterParameter=1200x630}"
                                                    Command="{Binding ResizeCanvasCommand}" CommandParameter="1200x630" ToolTip.Tip="Social Post (1200×630)">
                                                <TextBlock Text="Social Post" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Margin="0,0,5,5"
                                                    Classes.active="{Binding ActivePaperSize, Converter={StaticResource StringEqualsConverter}, ConverterParameter=1240x1754}"
                                                    Command="{Binding ResizeCanvasCommand}" CommandParameter="1240x1754" ToolTip.Tip="A4 Print (1240×1754)">
                                                <TextBlock Text="A4 Print" />
                                            </Button>
                                            <Button Classes="m3-preset-chip" Margin="0,0,5,5"
                                                    Classes.active="{Binding ActivePaperSize, Converter={StaticResource StringEqualsConverter}, ConverterParameter=640x480}"
                                                    Command="{Binding ResizeCanvasCommand}" CommandParameter="640x480" ToolTip.Tip="Standard 4:3 (640×480)">
                                                <TextBlock Text="Standard 4:3" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Orientation & Rotation -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Orientation &amp; Rotation" Classes="inspector-label" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <!-- M3 Segmented Capsule for Portrait / Landscape -->
                                            <Border Grid.Column="0" Classes="m3-segmented-container" Padding="2">
                                                <Grid ColumnDefinitions="*,*">
                                                    <Button Grid.Column="0" Classes="m3-segment-btn" Height="28" Padding="6,0"
                                                            Classes.active="{Binding IsPortrait}"
                                                            Command="{Binding SetPortraitCommand}"
                                                            ToolTip.Tip="Portrait Orientation">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="FileOutline" Width="13" Height="13" />
                                                            <TextBlock Text="Portrait" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Classes="m3-segment-btn" Height="28" Padding="6,0"
                                                            Classes.active="{Binding IsLandscape}"
                                                            Command="{Binding SetLandscapeCommand}"
                                                            ToolTip.Tip="Landscape Orientation">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="FileOutline" Width="13" Height="13" RenderTransformOrigin="50%,50%">
                                                                <materialIcons:MaterialIcon.RenderTransform>
                                                                    <RotateTransform Angle="90" />
                                                                </materialIcons:MaterialIcon.RenderTransform>
                                                            </materialIcons:MaterialIcon>
                                                            <TextBlock Text="Landscape" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Tactile 90° Rotate Buttons Group -->
                                            <Border Grid.Column="1" Classes="m3-segmented-container" Padding="2">
                                                <StackPanel Orientation="Horizontal" Spacing="1">
                                                    <Button Classes="m3-segment-btn" Width="28" Height="28" Padding="0"
                                                            Command="{Binding RotateArtboardCounterClockwiseCommand}" ToolTip.Tip="Rotate Artboard Counter-Clockwise (90°)">
                                                        <materialIcons:MaterialIcon Kind="RotateLeft" Width="14" Height="14" HorizontalAlignment="Center" />
                                                    </Button>
                                                    <Button Classes="m3-segment-btn" Width="28" Height="28" Padding="0"
                                                            Command="{Binding RotateArtboardClockwiseCommand}" ToolTip.Tip="Rotate Artboard Clockwise (90°)">
                                                        <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" HorizontalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Custom Artboard Dimensions (Width & Height) -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Width (px)" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding CanvasWidth, Mode=TwoWay}" Minimum="100" Maximum="8000" Increment="10" FormatString="0"
                                                           CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                           HorizontalAlignment="Stretch" Height="30" FontSize="11.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Height (px)" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding CanvasHeight, Mode=TwoWay}" Minimum="100" Maximum="8000" Increment="10" FormatString="0"
                                                           CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                           HorizontalAlignment="Stretch" Height="30" FontSize="11.5" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Canvas Background Color Swatches -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Canvas Background Color" Classes="inspector-label" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Preset Color Swatches with Active State Indicators -->
                                            <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FFFFFF" BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1"
                                                    Command="{Binding SetBackgroundCommand}" CommandParameter="White" ToolTip.Tip="Pure White">
                                                <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            IsVisible="{Binding BackgroundColorName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=White}" />
                                            </Button>
                                            <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#F8FAFC" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                    Command="{Binding SetBackgroundCommand}" CommandParameter="Slate" ToolTip.Tip="Slate Tint">
                                                <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            IsVisible="{Binding BackgroundColorName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Slate}" />
                                            </Button>
                                            <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FEF3C7" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                    Command="{Binding SetBackgroundCommand}" CommandParameter="Warm" ToolTip.Tip="Parchment Cream">
                                                <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="#78350F" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            IsVisible="{Binding BackgroundColorName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Warm}" />
                                            </Button>
                                            <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#0F172A" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                    Command="{Binding SetBackgroundCommand}" CommandParameter="Black" ToolTip.Tip="Dark Slate">
                                                <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            IsVisible="{Binding BackgroundColorName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Black}" />
                                            </Button>
                                            <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="Transparent" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                    Command="{Binding SetBackgroundCommand}" CommandParameter="Transparent" ToolTip.Tip="Transparent Checkerboard">
                                                <Panel>
                                                    <materialIcons:MaterialIcon Kind="Checkerboard" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                IsVisible="{Binding BackgroundColorName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Transparent}" />
                                                </Panel>
                                            </Button>

                                            <!-- Custom Palette Picker Flyout -->
                                            <Button Classes="m3-icon-btn" Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" ToolTip.Tip="Custom Color Studio">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                                Padding="10">
                                                            <ColorView Color="{Binding BackgroundColor, Mode=TwoWay}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="0,2" />

                                    <!-- Quick Page Actions -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="PAGE ACTIONS" Classes="inspector-label" FontSize="10" />
                                        <Button Classes="m3-filled-btn" HorizontalAlignment="Stretch" Height="32"
                                                Command="{Binding OpenTemplateGalleryCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="14" Height="14" />
                                                <TextBlock Text="Explore Templates" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-tonal-btn" HorizontalAlignment="Stretch" Height="30"
                                                Command="{Binding ImportImageCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ImagePlus" Width="14" Height="14" />
                                                <TextBlock Text="Import Image File" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-tonal-btn" HorizontalAlignment="Stretch" Height="30"
                                                Command="{Binding CopyCanvasAsImageCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                                <TextBlock Text="Copy Canvas as Image" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ══════════════════════════════════════════════════════
                                 CARD 2: TRANSFORM & GEOMETRY (Visible when element selected)
                                 ══════════════════════════════════════════════════════ -->
                            <Border Classes="m3-card-elevated"
                                    IsVisible="{Binding HasSelectedElements}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Resize" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Transform &amp; Geometry" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>

                                    <!-- X & Y -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="X (px)" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding XField}" Increment="1" Height="26" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Y (px)" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding YField}" Increment="1" Height="26" FontSize="11" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- W & H -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Width" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding WidthField}" Minimum="1" Increment="1" Height="26" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Height" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding HeightField}" Minimum="1" Increment="1" Height="26" FontSize="11" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Rotation Angle -->
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Rotation Angle" Classes="inspector-label" />
                                            <TextBlock Grid.Column="1" Text="{Binding RotationField, StringFormat='{}{0:0}°'}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Grid>
                                        <Slider Classes="m3-tactile-slider" Minimum="0" Maximum="360" Value="{Binding RotationField}" Height="18" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ══════════════════════════════════════════════════════
                                 CARD 3: FILL & BORDER (Visible when shape selected)
                                 ══════════════════════════════════════════════════════ -->
                            <Border Classes="m3-card-elevated"
                                    IsVisible="{Binding IsShapeSelected}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FormatColorFill" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Fill &amp; Border" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>

                                    <!-- Fill Color -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Fill Color" Classes="inspector-label" />
                                        <Button Grid.Column="1" Width="26" Height="26" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                Background="{Binding ShapeFillColor, Converter={StaticResource ColorToBrushConverter}}"
                                                BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                    <ColorView Color="{Binding ShapeFillColor, Mode=TwoWay}" IsAlphaEnabled="True" Width="280" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <!-- Stroke Color & Width -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="Stroke &amp; Width" Classes="inspector-label" />
                                        <Button Grid.Column="1" Width="26" Height="26" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                Background="{Binding ShapeStrokeColor, Converter={StaticResource ColorToBrushConverter}}"
                                                BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                    <ColorView Color="{Binding ShapeStrokeColor, Mode=TwoWay}" IsAlphaEnabled="True" Width="280" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <NumericUpDown Grid.Column="2" Value="{Binding StrokeThicknessField}" Minimum="0" Maximum="40" Increment="1"
                                                       FormatString="0 pt" Height="26" FontSize="11" Width="68" />
                                    </Grid>

                                    <!-- Stroke Style Segmented Capsule -->
                                    <Border Classes="m3-segmented-container" HorizontalAlignment="Stretch">
                                        <UniformGrid Rows="1">
                                            <Button Command="{Binding SetDashStyleCommand}" CommandParameter="Solid" Classes="m3-segment-btn">
                                                <TextBlock Text="Solid" FontSize="10" />
                                            </Button>
                                            <Button Command="{Binding SetDashStyleCommand}" CommandParameter="Dashed" Classes="m3-segment-btn">
                                                <TextBlock Text="Dashed" FontSize="10" />
                                            </Button>
                                            <Button Command="{Binding SetDashStyleCommand}" CommandParameter="Dotted" Classes="m3-segment-btn">
                                                <TextBlock Text="Dotted" FontSize="10" />
                                            </Button>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ══════════════════════════════════════════════════════
                                 CARD 4: TYPOGRAPHY (Visible when text element selected)
                                 ══════════════════════════════════════════════════════ -->
                            <Border Classes="m3-card-elevated"
                                    IsVisible="{Binding IsTextSelected}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FormatText" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Typography Properties" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>

                                    <!-- Text Content -->
                                    <TextBox Classes="m3-outlined" Text="{Binding TextContentField, Mode=TwoWay}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                             FontSize="11.5" />

                                    <!-- Font Size & Formatting -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                        <NumericUpDown Grid.Column="0" Value="{Binding FontSizeField, Mode=TwoWay}" Minimum="6" Maximum="288" Increment="2" FormatString="0 pt" Height="28" FontSize="11.5"
                                                       CornerRadius="{StaticResource M3ShapeCornerMedium}" />
                                        <Border Grid.Column="1" Classes="m3-segmented-container" Padding="2">
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding IsBoldField, Mode=TwoWay}" ToolTip.Tip="Bold" Width="28" Height="28" Padding="0">
                                                    <TextBlock Text="B" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </ToggleButton>
                                                <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding IsItalicField, Mode=TwoWay}" ToolTip.Tip="Italic" Width="28" Height="28" Padding="0">
                                                    <TextBlock Text="I" FontStyle="Italic" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </ToggleButton>
                                                <ToggleButton Classes="m3-segment-btn" IsChecked="{Binding IsUnderlineField, Mode=TwoWay}" ToolTip.Tip="Underline" Width="28" Height="28" Padding="0">
                                                    <TextBlock Text="U" TextDecorations="Underline" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </ToggleButton>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══════════════════════════════════════════════════════
                                 CARD 5: PHOTO ADJUSTMENTS (Visible when image selected)
                                 ══════════════════════════════════════════════════════ -->
                            <Border Classes="m3-card-elevated"
                                    IsVisible="{Binding IsImageSelected}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ImageEditOutline" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Photo Fine-Tuning" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>

                                    <Button Classes="primary-btn" Height="26" Padding="8,0" Command="{Binding AutoEnhanceCommand}" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="AutoFix" Width="12" Height="12" Foreground="White" />
                                            <TextBlock Text="Auto-Enhance Photo" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Sliders -->
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Brightness" Classes="inspector-label" />
                                            <TextBlock Grid.Column="1" Text="{Binding BrightnessField, StringFormat='{}{0:0}'}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Grid>
                                        <Slider Classes="m3-tactile-slider" Minimum="-100" Maximum="100" Value="{Binding BrightnessField}" Height="18" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Contrast" Classes="inspector-label" />
                                            <TextBlock Grid.Column="1" Text="{Binding ContrastField, StringFormat='{}{0:0}'}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Grid>
                                        <Slider Classes="m3-tactile-slider" Minimum="-100" Maximum="100" Value="{Binding ContrastField}" Height="18" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Saturation" Classes="inspector-label" />
                                            <TextBlock Grid.Column="1" Text="{Binding SaturationField, StringFormat='{}{0:0}'}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Grid>
                                        <Slider Classes="m3-tactile-slider" Minimum="-100" Maximum="100" Value="{Binding SaturationField}" Height="18" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             ROW 3: BOTTOM STUDIO STATUS BAR (Dimensions, Zoom, Tool)
             ============================================================ -->
        <Border Grid.Row="3"
                Background="{DynamicResource WinBgBrush}"
                BorderBrush="{DynamicResource WinBorderBrush}"
                BorderThickness="0,1,0,0"
                Height="28"
                Padding="12,0,12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Status Chips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="m3-chip" Padding="6,1.5">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="AspectRatio" Width="11" Height="11" Foreground="{DynamicResource WinAccentBrush}" />
                            <TextBlock Text="{Binding DimensionStatusText}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Classes="m3-chip" Padding="6,1.5">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="11" Height="11" Foreground="{DynamicResource WinMutedBrush}" />
                            <TextBlock Text="{Binding Elements.Count, StringFormat='{}{0} Elements'}" FontSize="10" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SelectionStatusText}" FontSize="10" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- Center: Status Message -->
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="10.5" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right: Zoom Controls & Tactile Slider -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="mini-tool-btn" Width="20" Height="20" Command="{Binding FitToWindowCommand}" ToolTip.Tip="Fit Artboard to Viewport">
                        <materialIcons:MaterialIcon Kind="FitToScreen" Width="12" Height="12" />
                    </Button>
                    <Button Classes="mini-tool-btn" Width="20" Height="20" Command="{Binding ResetZoomCommand}" ToolTip.Tip="Zoom 1:1 (100%)">
                        <TextBlock Text="1:1" FontSize="9" FontWeight="Bold" />
                    </Button>
                    <Button Classes="mini-tool-btn" Width="18" Height="18" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out">
                        <materialIcons:MaterialIcon Kind="Minus" Width="11" Height="11" />
                    </Button>
                    <Slider Classes="m3-tactile-slider" Minimum="0.2" Maximum="4.0" Value="{Binding ZoomLevel, Mode=TwoWay}" Width="90" Height="16" />
                    <Button Classes="mini-tool-btn" Width="18" Height="18" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In">
                        <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" />
                    </Button>
                    <Border Classes="m3-chip" Padding="5,1">
                        <TextBlock Text="{Binding ZoomLevel, Converter={StaticResource ZoomLevelToPercentConverter}}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             MODAL 1: TEMPLATE GALLERY OVERLAY (28px Dialog Card)
             ============================================================ -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#99000000"
                IsVisible="{Binding IsTemplateGalleryOpen}"
                ZIndex="1000">
            <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource M3ShapeCornerExtraLarge}"
                    BoxShadow="{StaticResource M3ElevationLevel4}"
                    MaxWidth="840" MaxHeight="600"
                    Margin="32" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Choose a Starter Template" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                            <TextBlock Text="Select a curated design layout to start editing immediately." FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="m3-icon-btn" Width="32" Height="32" Command="{Binding CloseTemplateGalleryCommand}">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredTemplateCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TemplateCardViewModel">
                                    <Button Classes="m3-template-card" Width="240" Margin="6"
                                            Command="{Binding $parent[UserControl].((local:ImageEditorViewModel)DataContext).UseTemplateCommand}"
                                            CommandParameter="{Binding Definition}">
                                        <Grid RowDefinitions="140,Auto">
                                            <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="12,12,0,0" ClipToBounds="True" Padding="10">
                                                <Border Background="White" CornerRadius="3" BoxShadow="0 2 8 #22000000" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Image Source="{Binding Preview}" Stretch="Uniform" MaxHeight="120" />
                                                </Border>
                                            </Border>
                                            <Border Grid.Row="1" Background="{DynamicResource M3SurfaceContainerLowBrush}" CornerRadius="0,0,12,12" Padding="12,8">
                                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="{DynamicResource M3SurfaceContainerHighestBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6,2" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding DimensionsLabel}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Classes="m3-tonal-btn" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Command="{Binding CloseTemplateGalleryCommand}" Content="Cancel" />
                </Grid>
            </Border>
        </Border>

        <!-- ============================================================
             MODAL 2: CONFIRM DISCARD CHANGES DIALOG
             ============================================================ -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#99000000"
                IsVisible="{Binding IsConfirmDiscardOpen}"
                ZIndex="1100">
            <Border Classes="m3-dialog-card" MaxWidth="380" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{DynamicResource M3ErrorContainerBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="6">
                            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource M3OnErrorContainerBrush}" />
                        </Border>
                        <TextBlock Text="Discard Unsaved Changes?" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding DiscardPromptMessage}" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                        <Button Grid.Column="0" Classes="m3-tonal-btn" Height="32" Content="Cancel"
                                Command="{Binding CancelDiscardCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Grid.Column="1" Classes="m3-filled-btn" Height="32" Content="Discard"
                                Background="{DynamicResource M3ErrorBrush}" Foreground="{DynamicResource M3OnErrorBrush}"
                                Command="{Binding ConfirmDiscardCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

    <!-- Styles & Refinements -->
    <UserControl.Styles>
        <Style Selector="Button.m3-layer-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="{StaticResource M3ShapeCornerSmall}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.m3-layer-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
        <Style Selector="Button.m3-template-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.m3-template-card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>
        <Style Selector="Button.m3-list-item-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.m3-list-item-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
