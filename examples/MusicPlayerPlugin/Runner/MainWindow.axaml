<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:PdfEditorApp.Plugins.MusicPlayer"
        mc:Ignorable="d"
        x:Class="PdfEditorApp.Plugins.MusicPlayer.Runner.MainWindow"
        Title="🎵 FryPDF Music Player — M3 Expressive Studio"
        Width="380" Height="540"
        MinWidth="350" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17">

    <local:MusicPlayerView x:Name="PlayerView" Margin="10" />
</Window>
