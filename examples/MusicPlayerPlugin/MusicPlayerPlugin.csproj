<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <AssemblyName>MusicPlayerPlugin</AssemblyName>
    <PackageId>FryPdf.Plugin.MusicPlayer</PackageId>
    <RootNamespace>PdfEditorApp.Plugins.MusicPlayer</RootNamespace>
    <Version>1.0.0</Version>
    <Company>FryPDF Tools Team</Company>
    <Description>Floating playlist-based music player shell overlay plugin for FryPDF</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);Runner/**</DefaultItemExcludes>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FryPdf.PluginSdk" Version="0.0.8" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common dependencies provided at runtime by the FryPDF host -->
    <PackageReference Include="Avalonia" Version="12.1.2" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" PrivateAssets="all" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- NOT provided by the host: bundled into the .fryplugin below -->
    <PackageReference Include="SoundFlow" Version="1.4.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Packaging into .fryplugin distribution archive -->
  <Target Name="PackageFryPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginStagingDir>$(TargetDir)staging\</PluginStagingDir>
      <OutputFryPlugin>$(TargetDir)MusicPlayer.fryplugin</OutputFryPlugin>
    </PropertyGroup>

    <RemoveDir Directories="$(PluginStagingDir)" />
    <MakeDir Directories="$(PluginStagingDir)" />

    <!--
      Unlike Avalonia/Mvvm/Material.Icons (already loaded by the host process),
      SoundFlow/TagLibSharp and the native MiniAudio runtime are NOT provided by the
      host, so they must ship inside the .fryplugin archive itself. SoundFlow ships
      properly-laid-out runtimes/<rid>/native/ folders for every platform it supports
      (including osx-arm64), so the whole runtimes/ tree is bundled as-is.
    -->
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)MusicPlayerPlugin.dll" />
      <PluginFiles Include="$(TargetDir)MusicPlayerPlugin.deps.json" Condition="Exists('$(TargetDir)MusicPlayerPlugin.deps.json')" />
      <PluginFiles Include="$(TargetDir)SoundFlow.dll" />
      <PluginFiles Include="$(TargetDir)TagLibSharp.dll" />
      <PluginFiles Include="$(ProjectDir)plugin.json" />
      <!-- Only the miniaudio native binaries, not the host's own unrelated transitive runtime assets
           (QuestPDF/SkiaSharp/Avalonia-native etc.) that CopyLocalLockFileAssemblies also pulls in. -->
      <PluginNativeFiles Include="$(TargetDir)runtimes\**\*miniaudio*" Condition="Exists('$(TargetDir)runtimes')" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginStagingDir)" />
    <Copy SourceFiles="@(PluginNativeFiles)" DestinationFolder="$(PluginStagingDir)runtimes\%(RecursiveDir)" Condition="'@(PluginNativeFiles)' != ''" />
    <Delete Files="$(OutputFryPlugin)" Condition="Exists('$(OutputFryPlugin)')" />
    <ZipDirectory SourceDirectory="$(PluginStagingDir)" DestinationFile="$(OutputFryPlugin)" />
    <RemoveDir Directories="$(PluginStagingDir)" />

    <Message Importance="High" Text="✨ Successfully packaged FryPDF plugin: $(OutputFryPlugin)" />
  </Target>
</Project>
