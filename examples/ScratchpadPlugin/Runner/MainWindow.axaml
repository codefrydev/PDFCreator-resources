<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:PdfEditorApp.Plugins.Scratchpad"
        mc:Ignorable="d"
        x:Class="PdfEditorApp.Plugins.Scratchpad.Runner.MainWindow"
        Title="Review Scratchpad - Standalone Runner"
        Width="400" Height="360"
        MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#090D13">

    <Grid Margin="18">
        <local:ScratchpadView x:Name="ScratchpadView"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
    </Grid>
</Window>
