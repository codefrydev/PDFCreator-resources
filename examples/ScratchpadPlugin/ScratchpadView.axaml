<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:PdfEditorApp.Plugins.Scratchpad"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="300"
             x:Class="PdfEditorApp.Plugins.Scratchpad.ScratchpadView"
             x:DataType="local:ScratchpadViewModel"
             Width="340" Height="280">

    <Grid RowDefinitions="*,Auto" Margin="12,10,12,12">
        <!-- 1. Text Area -->
        <Border Grid.Row="0"
                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                Padding="8">
            <TextBox Text="{Binding NotesText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas, Menlo, Monaco, monospace"
                     FontSize="12.5"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="Type review notes, annotations, or checklists..." />
        </Border>

        <!-- 2. Bottom Actions & Stats Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0" VerticalAlignment="Center">
            <!-- Stats -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding WordCount, StringFormat='{}{0} words'}"
                           FontSize="11"
                           Foreground="{DynamicResource WinMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·" Foreground="{DynamicResource WinMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} chars'}"
                           FontSize="11"
                           Foreground="{DynamicResource WinMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Action Pills -->
            <Button Grid.Column="2"
                    Command="{Binding AddTimestampCommand}"
                    Classes="m3-tonal-btn"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Padding="10,4"
                    Margin="0,0,6,0"
                    Cursor="Hand"
                    ToolTip.Tip="Insert Current Timestamp">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="13" Height="13" />
                    <TextBlock Text="Time" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Command="{Binding ClearNotesCommand}"
                    Classes="m3-outlined-btn"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Padding="10,4"
                    Cursor="Hand"
                    ToolTip.Tip="Clear All Notes">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="13" Height="13" />
                    <TextBlock Text="Clear" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>

</UserControl>
